					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"var jsonData = pm.response.json();",
									"if (jsonData.access_token) {",
									"    pm.collectionVariables.set('access_token', jsonData.access_token);",
									"}",
									"if (jsonData.refresh_token) {",
									"    pm.collectionVariables.set('refresh_token', jsonData.refresh_token);",
									"}"
								]
							}
						}
					],
					"request": {
						"auth": {
							"type": "noauth"
						},
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"user\": {\n    \"email\": \"{{email}}\",\n    \"application\": {\n      \"app_id\": \"{{app_id}}\",\n      \"app_secret\": \"{{app_secret}}\"\n    },\n    \"password\": \"{{password}}\"\n  }\n}"
						},
						"url": {
							"raw": "{{base_url_user}}/users/sign_in.json",
							"host": ["{{base_url_user}}"],
							"path": ["users", "sign_in.json"]
						},
						"description": "Authenticate with the Ayla Networks API. Returns access_token and refresh_token. The access_token expires in 86400 seconds (24 hours)."
					},
